# Supabase Local Configuration
# Para local development, estos valores apuntan a http://127.0.0.1:54331
# Obtén las claves corriendo: supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Story 4.2 — pago real, modo test). Clave publicable únicamente:
# la clave secreta/restringida vive solo en supabase/functions/.env, nunca
# aquí ni en el cliente. Sandbox de desarrollo (no el test mode compartido de
# una cuenta), creada con `stripe sandbox create` — ver CLAUDE.md §Procesamiento
# de pagos (Stripe). En staging/prod: la publishable key del proyecto Stripe
# correspondiente, dada de alta como env var de Vercel.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=