# Copiar a supabase/functions/.env (gitignorado vía el ".env" del .gitignore
# raíz) y rellenar con valores reales. Nunca commitear ese archivo.

# Secreto del Auth Hook "Send Email" (Standard Webhooks), formato v1,whsec_<base64>.
# Generar uno propio para desarrollo local, p.ej.:
#   openssl rand -base64 32
# y anteponer "v1,whsec_" al resultado.
SEND_EMAIL_HOOK_SECRET=

# API key de Brevo: app.brevo.com > SMTP & API > API Keys.
BREVO_API_KEY=

# Remitente verificado en Brevo: app.brevo.com > Senders, Domains & Dedicated IPs.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LuxePass

# URL base de la app (Next.js) para construir el link de /auth/confirm.
# No es lo mismo que auth.site_url de config.toml ni que email_data.site_url
# del hook: ese último resuelve al puerto del API de Supabase, no al dev
# server de Next. Local: http://127.0.0.1:3000 (el puerto por defecto de
# `npm run dev` — si corre en otro puerto en esta máquina, ajustar aquí).
APP_URL=

# Etiqueta de ambiente para el subject del correo: LOCAL, STAGING o PROD.
APP_ENV=

# Stripe (Story 4.2 — pago real, modo test en local/staging). Clave
# restringida (rk_/rkcs_), nunca la secreta completa (sk_) — ver
# CLAUDE.md §Procesamiento de pagos (Stripe). Generarla con
# `stripe sandbox create` (dev local) o desde el dashboard del proyecto
# Stripe correspondiente (staging/prod).
STRIPE_SECRET_KEY=

# Secreto de firma del webhook (`whsec_...`). En local: `stripe listen
# --forward-to <url-de-la-function>` lo imprime al arrancar. En
# staging/prod: el que asigna el endpoint de webhook creado en el
# dashboard de Stripe para ese proyecto.
STRIPE_WEBHOOK_SECRET=

# Story 4.2/5.1 — recibo de reserva real (Database Webhook, ver
# supabase/schemas/booking_receipts.sql y CLAUDE.md §Email de recibo de
# reserva). Debe ser EXACTAMENTE el mismo valor que el secreto de Vault
# 'booking_receipt_webhook_secret' de este proyecto (local/dev/prod tienen
# cada uno el suyo, dado de alta una vez con
# `select vault.create_secret(valor, 'booking_receipt_webhook_secret', ...)`
# — nunca vía `supabase config push`, mismo motivo que el hook de Brevo).
BOOKING_RECEIPT_WEBHOOK_SECRET=

# Story 5.3 — recordatorio 24h antes (pg_cron, ver
# supabase/schemas/booking_reminders.sql). Mismo patrón que
# BOOKING_RECEIPT_WEBHOOK_SECRET: debe coincidir con el secreto de Vault
# 'booking_reminder_webhook_secret' de este proyecto.
BOOKING_REMINDER_WEBHOOK_SECRET=

# Story 6.3 — borrado físico real tras los 30 días de gracia (pg_cron, ver
# supabase/schemas/account_deletion.sql). Mismo patrón que
# BOOKING_RECEIPT_WEBHOOK_SECRET: debe coincidir con el secreto de Vault
# 'account_deletion_webhook_secret' de este proyecto.
ACCOUNT_DELETION_WEBHOOK_SECRET=
