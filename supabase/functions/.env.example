# Copiar a supabase/functions/.env (gitignorado vía el ".env" del .gitignore
# raíz) y rellenar con valores reales. Nunca commitear ese archivo.

# Secreto del Auth Hook "Send Email" (Standard Webhooks), formato v1,whsec_<base64>.
# Generar uno propio para desarrollo local, p.ej.:
#   openssl rand -base64 32
# y anteponer "v1,whsec_" al resultado.
SEND_EMAIL_HOOK_SECRET=

# API key de Brevo: app.brevo.com > SMTP & API > API Keys.
BREVO_API_KEY=

# Remitente verificado en Brevo: app.brevo.com > Senders, Domains & Dedicated IPs.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LuxePass

# URL base de la app (Next.js) para construir el link de /auth/confirm.
# No es lo mismo que auth.site_url de config.toml ni que email_data.site_url
# del hook: ese último resuelve al puerto del API de Supabase, no al dev
# server de Next. Local: http://127.0.0.1:3000 (el puerto por defecto de
# `npm run dev` — si corre en otro puerto en esta máquina, ajustar aquí).
APP_URL=

# Etiqueta de ambiente para el subject del correo: LOCAL, STAGING o PROD.
APP_ENV=
